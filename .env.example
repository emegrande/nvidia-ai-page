# Variables de entorno para NVIDIA AI Page

# Puerto del servidor
PORT=3000

# Entorno (development, production)
NODE_ENV=development

# API Key de NVIDIA
# Obtén tu clave en: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=nvapi-tu-clave-aqui

# CORS - Origenes permitidos (separados por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30

# Logs
LOG_LEVEL=info
